# ==============================================================================
# APORIA TRACE / NEURAX — Intelligence Integration Configuration Template
# Copy this file to backend/.env and populate with your API credentials.
# NEVER commit backend/.env or any API keys to version control.
# ==============================================================================

# GitHub REST API Token (Optional: Unauthenticated mode works with 60 req/hr rate limit;
# token provides 5,000 req/hr for deep repository and contribution discovery)
GITHUB_TOKEN=

# Public Web Search Provider API Key (Preferred: Tavily; Fallback: DuckDuckGo is automatic)
TAVILY_API_KEY=

# AI Extraction & Copilot Reasoning API Keys (Optional: deterministic rule extraction runs if absent)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Provider Selectors
AI_PROVIDER=gemini
SEARCH_PROVIDER=tavily

# Operational Limits & Network Guards
API_TIMEOUT=15
MAX_SEARCH_RESULTS=10
MAX_REQUEST_SIZE=10485760
